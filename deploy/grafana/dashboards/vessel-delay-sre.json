{
  "title": "Vessel Delay SRE",
  "uid": "vessel-delay-sre",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "sum by (service) (rate(vessel_http_requests_total[5m]))", "legendFormat": "{{service}}"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latency P50 / P95 / P99",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (service, le) (rate(vessel_http_request_duration_seconds_bucket[5m])))", "legendFormat": "P50 {{service}}"},
        {"expr": "histogram_quantile(0.95, sum by (service, le) (rate(vessel_http_request_duration_seconds_bucket[5m])))", "legendFormat": "P95 {{service}}"},
        {"expr": "histogram_quantile(0.99, sum by (service, le) (rate(vessel_http_request_duration_seconds_bucket[5m])))", "legendFormat": "P99 {{service}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Error budget remaining",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{"expr": "vessel_error_budget_remaining_ratio", "legendFormat": "{{service}}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "SLO burn rate",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{"expr": "vessel_slo_burn_rate", "legendFormat": "{{service}}"}],
      "fieldConfig": {"defaults": {"unit": "none", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}] }}, "overrides": []}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU utilization",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [{"expr": "vessel_process_cpu_percent", "legendFormat": "{{service}}"}],
      "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Memory resident set",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [{"expr": "vessel_process_memory_bytes", "legendFormat": "{{service}}"}],
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Error rate",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "targets": [{"expr": "vessel_service_error_rate", "legendFormat": "{{service}}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Availability",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "targets": [{"expr": "vessel_service_availability_ratio", "legendFormat": "{{service}}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}
    }
  ]
}

# Reusable image name for local Docker and cloud registries.
VESSEL_DELAY_IMAGE=vessel-delay-mlops:local

# Set these to a remote MLflow tracking/registry service in a cloud deployment.
# Examples: https://mlflow.example.com or a private service endpoint.
MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db
MLFLOW_REGISTRY_URI=sqlite:///mlruns/mlflow.db
MLFLOW_ENABLED=true

# Optional provider-neutral volume names for local development.
VESSEL_DELAY_MLRUNS_VOLUME=vessel-delay-mlruns
VESSEL_DELAY_MODEL_VOLUME=vessel-delay-models
VESSEL_DELAY_PREDICTION_VOLUME=vessel-delay-predictions

# Optional MLflow image override for a private registry.
MLFLOW_IMAGE=ghcr.io/mlflow/mlflow:v3.0.0